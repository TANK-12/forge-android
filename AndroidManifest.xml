<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.forge.phone" android:versionCode="23" android:versionName="0.23">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- this device's own Wi-Fi address, to find computers on the same network -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- the jobs widget's 30-minute job survives a restart (JobInfo.setPersisted) -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- the visualiser and the particles hear the music: this device's own sound
       (Visualizer) or the microphone; asked the first time a sound source is picked -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <!-- updates (task 1316): Forge hands a newer copy of itself to Android's installer -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- a theme picture as a plain still wallpaper (task 1322) -->
  <uses-permission android:name="android.permission.SET_WALLPAPER" />
  <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
  <!-- task 1330 & 1591: find the tablet's live wallpaper screen and default launcher -->
  <queries>
    <intent><action android:name="android.service.wallpaper.CHANGE_LIVE_WALLPAPER" /></intent>
    <intent><action android:name="android.service.wallpaper.LIVE_WALLPAPER_CHOOSER" /></intent>
    <intent><action android:name="android.intent.action.SET_WALLPAPER" /></intent>
    <intent><action android:name="android.service.wallpaper.WallpaperService" /></intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
    <package android:name="com.android.wallpaper.livepicker" />
    <package android:name="com.google.android.apps.wallpaper" />
    <package android:name="com.android.wallpaper" />
    <package android:name="com.samsung.android.app.dressroom" />
    <package android:name="com.miui.home" />
  </queries>
  <uses-feature android:name="android.hardware.microphone" android:required="false" />
  <application android:label="@string/name" android:icon="@mipmap/icon"
      android:usesCleartextTraffic="false" android:allowBackup="false"
      android:hardwareAccelerated="true"
      android:theme="@android:style/Theme.Material.NoActionBar">
    <activity android:name=".Main" android:exported="true" android:launchMode="singleTask"
        android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
        android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- long-press the icon: the visualiser, wallpaper and widgets -->
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
      <!-- the pairing link Devices, Phones shows as a picture for the camera -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="forge-phone" android:host="pair" />
      </intent-filter>
      <!-- Share, Forge: send files to a paired computer's inbox -->
      <intent-filter android:label="@string/send">
        <action android:name="android.intent.action.SEND" />
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
    </activity>
    <!-- Forge jobs, queue, next up, media and quick-launch widgets (tasks 1301 & 1591).
         AppWidgetProvider receivers are exported="true" per Android docs so strict OEM
         tablet launchers can bind and update them reliably. -->
    <receiver android:name=".JobsWidget" android:exported="true" android:label="@string/jobs">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_jobs" />
    </receiver>
    <receiver android:name=".QueueWidget" android:exported="true" android:label="@string/queue">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_queue" />
    </receiver>
    <receiver android:name=".MediaWidget" android:exported="true" android:label="@string/media">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_media" />
    </receiver>
    <receiver android:name=".NextUpWidget" android:exported="true" android:label="@string/next_up">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next_up" />
    </receiver>
    <receiver android:name=".QuickForgeWidget" android:exported="true" android:label="@string/quick_launch">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick" />
    </receiver>
    <!-- Custom home-screen widgets built in Forge Studio (task 1592) -->
    <receiver android:name=".CustomWidget$Compact" android:exported="true" android:label="@string/custom_compact">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_custom_compact" />
    </receiver>
    <receiver android:name=".CustomWidget$Card" android:exported="true" android:label="@string/custom_card">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_custom_card" />
    </receiver>
    <receiver android:name=".CustomWidget$Board" android:exported="true" android:label="@string/custom_board">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_custom_board" />
    </receiver>
    <service android:name=".JobsWidget$Refresh" android:exported="false"
        android:permission="android.permission.BIND_JOB_SERVICE" />
    <!-- Optional event-driven media session reader for MediaWidget song titles (task 1591) -->
    <service android:name=".MediaBridge" android:exported="true" android:label="@string/media_listener"
        android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
    <!-- Android's installer answers here while an update installs (task 1316) -->
    <receiver android:name=".Updates$Done" android:exported="false" />

    <!-- The Forge Visualiser, folded in (task 1316; source phone/theme/visualiser).
         Exported: the live wallpaper picker opens it as the wallpaper's settings. -->
    <activity android:name="app.forge.visualiser.PlayerActivity" android:exported="true"
        android:label="@string/viz_name" android:icon="@mipmap/viz_icon"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
    <service android:name="app.forge.visualiser.VizWallpaper" android:exported="true"
        android:label="@string/viz_wallpaper" android:permission="android.permission.BIND_WALLPAPER">
      <intent-filter>
        <action android:name="android.service.wallpaper.WallpaperService" />
      </intent-filter>
      <meta-data android:name="android.service.wallpaper" android:resource="@xml/viz_wallpaper" />
    </service>
    <receiver android:name="app.forge.visualiser.VizWidget" android:exported="true"
        android:label="@string/viz_widget">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_visualiser" />
    </receiver>

    <!-- Forge Theme, folded in (task 1316; source phone/theme/theme): the particles
         wallpaper, its settings, and the clock, particles and music widgets -->
    <activity android:name="app.forge.theme.ThemeActivity" android:exported="true"
        android:label="@string/theme_in_forge" android:icon="@mipmap/theme_icon"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />
    <service android:name="app.forge.theme.ThemeWallpaper" android:exported="true"
        android:label="@string/theme_wallpaper" android:permission="android.permission.BIND_WALLPAPER">
      <intent-filter>
        <action android:name="android.service.wallpaper.WallpaperService" />
      </intent-filter>
      <meta-data android:name="android.service.wallpaper" android:resource="@xml/theme_wallpaper" />
    </service>
    <receiver android:name="app.forge.theme.Widgets$ClockWidget" android:exported="true"
        android:label="@string/clock">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_clock" />
    </receiver>
    <receiver android:name="app.forge.theme.Widgets$ParticlesWidget" android:exported="true"
        android:label="@string/particles_widget">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_particles" />
    </receiver>
    <receiver android:name="app.forge.theme.Widgets$MusicWidget" android:exported="true"
        android:label="@string/music">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_music" />
    </receiver>
  </application>
</manifest>
