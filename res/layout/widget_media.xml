<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="4dp">
  <ImageView android:id="@+id/bg" android:layout_width="match_parent"
      android:layout_height="match_parent" android:src="@drawable/panel" android:scaleType="fitXY"
      android:contentDescription="@null" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
      android:orientation="vertical" android:gravity="center_vertical"
      android:paddingStart="14dp" android:paddingEnd="10dp"
      android:paddingTop="8dp" android:paddingBottom="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
      <LinearLayout android:id="@+id/header_area" android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/badge" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
            android:textSize="11sp" android:fontFamily="sans-serif-medium"
            android:textColor="#ff7cc4a4" android:text="Forge media" />
        <TextView android:id="@+id/track" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
            android:textSize="16sp" android:fontFamily="sans-serif-medium"
            android:textColor="#ffffffff" android:text="Now playing" />
        <TextView android:id="@+id/artist" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
            android:textSize="12sp" android:textColor="#b3ffffff"
            android:text="Controls ready · Tap here for song titles" />
      </LinearLayout>
      <ImageView android:id="@+id/swap" android:layout_width="38dp" android:layout_height="38dp"
          android:padding="9dp" android:src="@drawable/ic_swap" android:visibility="gone"
          android:contentDescription="Switch device or computer" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center">
      <ImageButton android:id="@+id/prev" android:layout_width="0dp" android:layout_height="48dp"
          android:layout_weight="1" android:src="@drawable/ic_prev" android:background="@null"
          android:contentDescription="Previous" />
      <ImageButton android:id="@+id/play" android:layout_width="0dp" android:layout_height="48dp"
          android:layout_weight="1" android:src="@drawable/ic_play_pause" android:background="@null"
          android:contentDescription="Play or pause" />
      <ImageButton android:id="@+id/pause" android:layout_width="0dp" android:layout_height="48dp"
          android:layout_weight="1" android:src="@drawable/ic_pause" android:background="@null"
          android:contentDescription="Pause" />
      <ImageButton android:id="@+id/next" android:layout_width="0dp" android:layout_height="48dp"
          android:layout_weight="1" android:src="@drawable/ic_next" android:background="@null"
          android:contentDescription="Next" />
      <ImageButton android:id="@+id/vis" android:layout_width="0dp" android:layout_height="48dp"
          android:layout_weight="1" android:src="@drawable/ic_visualiser" android:background="@null"
          android:contentDescription="Open Forge Visualiser" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
